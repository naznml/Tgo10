function renderReading(){
  return `
    <div class="card" data-test="englishReading">
      <h3>
        <span class="kk">Оқу</span>
        <span class="ru">Чтение</span>
      </h3>
      ${readingBlocks.map(item=>{
        if(item.type==="text"){
          return `<div class="textBlock"><h4>${item.title}</h4><p>${item.text.replace(/\n/g,"</p><p>")}</p></div>`;
        }
        return renderQuestion("englishReading",item.q);
      }).join("")}
      <div class="actions">
        <button class="btn" type="button" onclick="checkTest('englishReading')">
          <span class="kk">Reading нәтижесін көрсету</span>
          <span class="ru">Показать результат Reading</span>
        </button>
        <button class="btn secondary" type="button" onclick="resetTest('englishReading')">
          <span class="kk">Қайта өту</span>
          <span class="ru">Пройти заново</span>
        </button>
      </div>
      <div class="result" id="englishReadingResult"></div>
    </div>
  `;
}
function renderEnglish(){
  const box = document.getElementById("englishBlock");
  box.innerHTML = `
    ${listeningSections.map(section=>renderListeningSection(section)).join("")}
    ${renderGrammar()}
    ${renderReading()}
  `;
  initTabs();
}

function rerenderAll(){
  renderCritical();
  renderAnalytical();
  renderEnglish();
}

document.addEventListener("DOMContentLoaded",()=>{
  rerenderAll();
});

document.querySelectorAll(".lang button").forEach(btn=>{
  btn.addEventListener("click",()=>{
    setTimeout(()=>{
      rerenderAll();
    },0);
  });
});
</script>
</body>
</html>
