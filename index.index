function renderGrammar(){
  return `
    <div class="card" data-test="englishGrammar">
      <h3>
        <span class="kk">Лексика-грамматикалық тест</span>
        <span class="ru">Лексико-грамматический тест</span>
      </h3>
      ${grammarQuestions.map(q=>renderQuestion("englishGrammar",q)).join("")}
      <div class="actions">
        <button class="btn" type="button" onclick="checkTest('englishGrammar')">
          <span class="kk">Grammar нәтижесін көрсету</span>
          <span class="ru">Показать результат Grammar</span>
        </button>
        <button class="btn secondary" type="button" onclick="resetTest('englishGrammar')">
          <span class="kk">Қайта өту</span>
          <span class="ru">Пройти заново</span>
        </button>
      </div>
      <div class="result" id="englishGrammarResult"></div>
    </div>
  `;
}
const readingBlocks = [
  {
    type:"text",
    title:"Reading Text 1 — International Children's Book Day",
    text:`The International Children's Book Day (ICBD) celebration is on April 2nd every year. This is the birthday of Hans Christian Andersen, one of the most famous children's writers. The celebration started in 1925. Today it is sponsored by the International Board on Books for Young People. This is a non-profit organization which aims at encouraging children to read more books. The ICBD celebrations are held across the world and include guest appearances by famous authors and illustrators, hold writing competitions, awards the competition winners with books. It is a busy day for school and public libraries. The ICBD also aims to promote international understanding through children’s books, to increase children's access to books, and to encourage the publication of better quality children's books.

Hans Christian Andersen was born in Denmark in 1805 and died in 1875. He was an author and poet. He is best known for his fairy tales, which are loved by children all around the world. Among his best-known stories are The Snow Queen, The Little Mermaid, Thumbelina, and The Ugly Duckling. He became more famous throughout Europe with every book he wrote. His fairy tales have been translated into over 150 languages. Millions of copies are still sold every year. They are so popular that they have become a part of the reading culture of most countries. They are permanently on teachers reading lists and school library shelves. When Andersen was a child, he had a passionate love for books, which prompted him to write stories for children.`
