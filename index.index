function renderAnalytical(){
  const box = document.getElementById("analyticalQuestions");
  box.innerHTML = analyticalBlocks.map(item=>{
    if(item.type === "text"){
      return renderTextBlock({
        title:{kk:item.kkTitle,ru:item.ruTitle},
        text:{kk:item.kkText,ru:item.ruText}
      });
    }
    return renderQuestion("analytical",item.q);
  }).join("");
}
const listeningSections = [
  {
    id:"l3",
    testKey:"englishListening",
    title:{kk:"Listening 1",ru:"Listening 1"},
    audio:"./TEXT 3 - АУДИО.mp3",
    transcript:`Well, I speak Spanish quite well. So, before I go to university I'm going to travel around South America. I've got an old school friend in Brazil and a pen friend in Guatemala. So, I have some people to visit. I also want to go and see the rain forest. I am working in the local restaurant at the moment. But as soon as I have enough money, I'll book a flight to Rio de Janeiro. I'll spend about a month in Brazil. Then go on to Guatemala, I think. I'm so looking forward to go. It'll be fantastic. When I'm travelling around, I’ll phone home twice a week. If I don't keep in touch, I know my parents will worry.`,
    translation:{
      kk:`Ал, мен испан тілінде өте жақсы сөйлеймін. Сондықтан университетке бармас бұрын, мен Оңтүстік Американы аралауға барамын. Менің Бразилияда ескі мектептегі досым және Гватемалада хат алмасатын досым бар. Сондықтан менде барып көретін бірнеше адам бар. Мен сондай-ақ тропикалық орманды көргім келеді. Қазір мен жергілікті мейрамханада жұмыс істеп жүрмін. Бірақ ақшам жеткілікті болған бойда, Рио-де-Жанейроға ұшаққа билет брондаймын. Мен Бразилияда шамамен бір ай боламын. Содан кейін, менің ойымша, Гватемалаға барамын. Мен баруды қатты асыға күтіп жүрмін. Бұл керемет болады. Саяхаттап жүрген кезде, мен үйге аптасына екі рет телефон соғамын. Егер байланыста болып тұрмасам, ата-анамның уайымдайтынын білемін.`,
      ru:`Ну, я довольно хорошо говорю по-испански. Поэтому, прежде чем я пойду в университет, я собираюсь путешествовать по Южной Америке. У меня есть старый школьный друг в Бразилии и друг по переписке в Гватемале. Поэтому у меня есть несколько людей, которых можно навестить. Я также хочу поехать и увидеть тропический лес. Сейчас я работаю в местном ресторане. Но как только у меня будет достаточно денег, я забронирую рейс в Рио-де-Жанейро. Я проведу около месяца в Бразилии. Потом, думаю, поеду дальше в Гватемалу. Я так жду этой поездки. Это будет фантастически. Когда я буду путешествовать, я буду звонить домой два раза в неделю. Если я не буду поддерживать связь, я знаю, что мои родители будут волноваться.`
    },
    vocab:[
      {en:"quite well",kk:"өте жақсы",ru:"довольно хорошо"},
      {en:"before",kk:"дейін",ru:"до того как"},
