function renderListeningSection(section){
  return `
    <div class="card" data-test="${section.id}">
      <h3>${t(section.title)}</h3>
      <div class="audioBox">
        <b>
          <span class="kk">Аудио</span>
          <span class="ru">Аудио</span>
        </b>
        <audio controls src="${section.audio}"></audio>
      </div>

      <div class="tabs" data-tabs="${section.id}">
        <button class="tab active" type="button" data-tab="test">
          <span class="kk">Тест</span><span class="ru">Тест</span>
        </button>
        <button class="tab" type="button" data-tab="transcript">
          <span class="kk">Транскрипт</span><span class="ru">Transcript</span>
        </button>
        <button class="tab" type="button" data-tab="translation">
          <span class="kk">Аударма</span><span class="ru">Перевод</span>
        </button>
        <button class="tab" type="button" data-tab="vocab">
          <span class="kk">Сөздік</span><span class="ru">Vocabulary</span>
        </button>
      </div>

      <div class="tabContent active" data-parent="${section.id}" data-content="test">
        ${section.questions.map(q=>renderQuestion(section.id,q)).join("")}
        <div class="actions">
          <button class="btn" type="button" onclick="checkEnglishListening()">
            <span class="kk">Listening нәтижесін көрсету</span>
            <span class="ru">Показать результат Listening</span>
          </button>
        </div>
      </div>

      <div class="tabContent" data-parent="${section.id}" data-content="transcript">
        ${section.transcript}
      </div>

      <div class="tabContent" data-parent="${section.id}" data-content="translation">
        ${t(section.translation)}
      </div>

      <div class="tabContent" data-parent="${section.id}" data-content="vocab">
        <div class="vocabGrid">
          ${section.vocab.map(v=>`
            <div class="vocabItem">
              <b>${v.en}</b><br>
              <span class="kk">${v.kk}</span>
              <span class="ru">${v.ru}</span>
            </div>
          `).join("")}
        </div>
      </div>
    </div>
  `;
}

function initTabs(){
  document.querySelectorAll(".tabs .tab").forEach(btn=>{
    btn.addEventListener("click",()=>{
      const parent = btn.closest(".tabs").dataset.tabs;
      const tab = btn.dataset.tab;
      document.querySelectorAll(`.tabs[data-tabs="${parent}"] .tab`).forEach(b=>b.classList.remove("active"));
      btn.classList.add("active");
      document.querySelectorAll(`.tabContent[data-parent="${parent}"]`).forEach(c=>{
        c.classList.toggle("active", c.dataset.content === tab);
      });
    });
  });
}

function checkEnglishListening(){
  let correct = 0;
  let total = 0;
  listeningSections.forEach(section=>{
    const card = document.querySelector(`[data-test="${section.id}"]`);
    const questions = card.querySelectorAll(".q");
    total += questions.length;
    questions.forEach(q=>{
      const answer = q.dataset.answer;
      const checked = q.querySelector("input:checked");
      q.classList.add("show");
      q.classList.remove("correct","wrong");
      q.querySelectorAll(".option").forEach(op=>{
        op.classList.remove("good","bad");
        if(op.dataset.value === answer) op.classList.add("good");
      });
      if(checked && checked.value === answer){
        correct++;
        q.classList.add("correct");
      }else{
        q.classList.add("wrong");
        if(checked) checked.closest(".option").classList.add("bad");
      }
    });
  });
  state.scores.englishListening = {correct,total};
  const old = document.getElementById("listeningResult");
  if(old) old.remove();
  const div = document.createElement("div");
  div.id = "listeningResult";
  div.className = "result";
  div.innerHTML = currentLang()==="kk"
    ? `Listening нәтижесі: ${correct} / ${total}`
    : `Результат Listening: ${correct} / ${total}`;
  document.querySelector("#englishBlock").prepend(div);
}
